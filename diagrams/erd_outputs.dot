digraph G {
graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=0.9, bgcolor="white", label="Outputs: what one row is, its key (blue), the script that writes it, and which files each script reads (arrow = read, label = join key)", labelloc=t, fontsize=14];
node [shape=plain, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, color="#47505e"];
"rules/<form>.json" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>rules/&lt;form&gt;.json</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">one rule</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">type, table, targets, allowed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">meaning, source, confidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by extract (LLM), team review</FONT></TD></TR></TABLE>>];
"rules_export.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>rules_export.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">one rule, with SQL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK rule_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">form, type, table, columns</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">rule, source, quote, confidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">note, added_after_review, sql_first_column</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/export.py</FONT></TD></TR></TABLE>>];
"<FORM>_results.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>&lt;FORM&gt;_results.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">rule × column × year × region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK rule_id, column, year, te</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">type, table, region, records</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">applicable, violations, conditional, bad_state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">rate</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/statquo.py</FONT></TD></TR></TABLE>>];
"<FORM>_region_flags.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>&lt;FORM&gt;_region_flags.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">flagged region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK rule_id, column, year, region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">synthesis, floor, independent, type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">records, applicable, violations, rate_region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">rate_rest, z, per_record_region, per_record_rest</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">excess, flag</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/statquo.py</FONT></TD></TR></TABLE>>];
"<FORM>_cross_form.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>&lt;FORM&gt;_cross_form.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">two-form share check</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK rule_id, year, te</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">check, region, this_share, other_share</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">upper_share, tolerance</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/statquo.py</FONT></TD></TR></TABLE>>];
"<FORM>_cross_form_flags.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>&lt;FORM&gt;_cross_form_flags.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">region outside the bounds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK rule_id, year, region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">this_share, other_share, upper_share, gap</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">flag, side, r2_other_regions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/statquo.py</FONT></TD></TR></TABLE>>];
"compare_region_sweep.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>compare_region_sweep.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">variable × region (Jensen-Shannon)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK form, table, year, variable, te</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">region, n, js, top_answer_region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">share_region, share_rest_same, robust_z</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/compare.py</FONT></TD></TR></TABLE>>];
"compare_year_c2st.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>compare_year_c2st.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">region, year vs year</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK form, te, compare</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">region, auc, top_features, robust_z</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/compare.py</FONT></TD></TR></TABLE>>];
"compare_invariants.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>compare_invariants.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">form-vs-form invariant</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK year, a, b, region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">a_share, b_share, gap, r2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">slope, regions_on_line</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/compare.py</FONT></TD></TR></TABLE>>];
"decoder_code_shift.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>decoder_code_shift.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">code that moved</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK form, year, region, column, code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">behaves_like, distance_to_match, distance_to_same_code, n</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">gain, ratio, flag</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by decoder/decode.py</FONT></TD></TR></TABLE>>];
"decoder_cases.json" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>decoder_cases.json</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">decoder numbers for cases</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK case</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by decoder/decoder_cases.py</FONT></TD></TR></TABLE>>];
"scorecard_issues.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>scorecard_issues.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">one issue</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK form, rule_id, year, region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">type, columns, example_column, records</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">rate_region, rate_rest, excess, synthesis</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">evidence, status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/scorecard.py</FONT></TD></TR></TABLE>>];
"cases.json" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>cases.json</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">one case file</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">title, forms, type, status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">finding, indicator, cause, fix</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">rules</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by engine/cases.py</FONT></TD></TR></TABLE>>];
"child_impact.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>child_impact.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">region × year</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK year, te</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">region, households, with_children_roster, answered_part4</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">answered_among_with_children, coverage_pct, deprived_pct, moe_pp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">kids_per_hh_answered, kids_per_hh_all, urban_answered_pct, urban_all_pct</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by analysis/child_impact.py</FONT></TD></TR></TABLE>>];
"proof_sensitivity.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>proof_sensitivity.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">one planted-error run</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK baseline, kind, rule, rate, trial, region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">background_rate, planted, eligible, detected</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">new_flags_other_regions, new_flags_same_region, same_region_rules</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by proof/plant.py</FONT></TD></TR></TABLE>>];
"schema_columns.csv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>schema_columns.csv</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">one column of the survey files</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2a6fd6">PK form, table, column</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">years, in_key, kind, filled_pct</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">distinct, top_values, profiled_year, doc_type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">doc_length, description, rule_ids, rules</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#47505e">documented</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by schema/profile.py</FONT></TD></TR></TABLE>>];
"console data.json" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cbd7"><TR><TD ALIGN="LEFT" BGCOLOR="#dce8fa"><B>console data.json</B><BR/><FONT POINT-SIZE="10" COLOR="#6a7381">everything the console shows</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a7381">written by console/build_console.py</FONT></TD></TR></TABLE>>];
"rules/<form>.json" -> "rules_export.csv" [label="rule_id = id"];
"rules/<form>.json" -> "<FORM>_results.csv" [label="rule_id = id"];
"<FORM>_results.csv" -> "<FORM>_region_flags.csv" [label="rule_id, column, year"];
"rules/<form>.json" -> "<FORM>_cross_form.csv" [label="rule_id = id"];
"<FORM>_cross_form.csv" -> "<FORM>_cross_form_flags.csv" [label="rule_id, year, te"];
"decoder_code_shift.csv" -> "decoder_cases.json" [label="form, column, code"];
"<FORM>_region_flags.csv" -> "scorecard_issues.csv" [label="rule_id, year, region"];
"<FORM>_cross_form_flags.csv" -> "scorecard_issues.csv" [label="rule_id, year, region"];
"decoder_code_shift.csv" -> "scorecard_issues.csv" [label="form, year, region"];
"compare_region_sweep.csv" -> "scorecard_issues.csv" [label="form, year, region"];
"<FORM>_results.csv" -> "cases.json" [label="rule_id, year, te"];
"<FORM>_region_flags.csv" -> "cases.json" [label="rule_id, year, region"];
"<FORM>_cross_form.csv" -> "cases.json" [label="rule_id, year, te"];
"decoder_cases.json" -> "cases.json" [label="case"];
"compare_region_sweep.csv" -> "cases.json" [label="form, year, te"];
"rules/<form>.json" -> "proof_sensitivity.csv" [label="rule = id"];
"rules/<form>.json" -> "schema_columns.csv" [label="rule_ids ∋ id"];
"rules_export.csv" -> "console data.json" [label="rule_id"];
"scorecard_issues.csv" -> "console data.json" [label="form, year, region"];
"cases.json" -> "console data.json" [label="id"];
"child_impact.csv" -> "console data.json" [label="year, te"];
"compare_year_c2st.csv" -> "console data.json" [label="te"];
"proof_sensitivity.csv" -> "console data.json" [label=""];
}